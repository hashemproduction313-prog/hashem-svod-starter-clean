{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],

    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "esModuleInterop": true,

    "plugins": [{ "name": "next" }],

    /* ✅ INDISPENSABLES — corrigent 100% des erreurs JSX / React / process */
    "types": ["node", "react", "react-dom"],

    /* ✅ Structure SRC conservée */
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    }
  },

  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    ".next/types/**/*.ts"
  ],

  "exclude": ["node_modules"]
}
